# ─── Database ───────────────────────────────────────────────
DATABASE_URL="postgresql://user:password@localhost:5432/stockmarket?schema=public"

# ─── Credential-free reviewer demo ─────────────────────────
# When true, all market prices/charts/search/profiles/news come from local,
# deterministic synthetic fixtures. Finnhub/Twelve Data calls are blocked.
# Run `npm run demo:seed` after migrations to add clearly synthetic evidence
# for the fictional DEMO ticker.
STOCKPULSE_DEMO_MODE="false"

# ─── Market data API keys ──────────────────────────────────
# Not needed in demo mode. In live mode, verify plan-specific display,
# redistribution and attribution rights before public deployment.
FINNHUB_API_KEY=""
TWELVEDATA_API_KEY=""

# ─── SEC EDGAR automated access ────────────────────────────
# Required before running LIVE SEC ingestion. The seeded demo path does not
# contact SEC. Use a descriptive app/company name and monitored contact.
SEC_USER_AGENT="StockPulse Research contact@example.com"

# ─── Optional grounded AI ──────────────────────────────────
# AI is disabled unless BOTH a key and model are configured. By default the
# server uses Vercel AI Gateway's OpenAI-compatible endpoint. AI_BASE_URL can
# point to another trusted OpenAI-compatible endpoint instead.
AI_GATEWAY_API_KEY=""
AI_API_KEY=""
AI_MODEL=""
AI_BASE_URL="https://ai-gateway.vercel.sh/v1"

# ─── App ───────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# ─── Polling ───────────────────────────────────────────────
POLL_INTERVAL_MS="15000"
POLL_SYMBOLS="AAPL,MSFT,GOOGL,AMZN,TSLA,META,NVDA,JPM,V,JNJ"
